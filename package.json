{
  "name": "hackxperience",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@hx/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts",
    "db:local": "node scripts/local-db.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "24.19.2",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
