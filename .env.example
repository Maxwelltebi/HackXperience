# Copy to apps/web/.env.local (web) and apps/mobile/.env (mobile). Never commit real values.

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Production: Supabase pooler, transaction mode (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Public base URL used in email links.
APP_URL=http://localhost:3000

# Server only. pg_cron sends it to /api/internal/tick; also stored in Supabase Vault (see 0004_cron).
TICK_SECRET=
# Server only. Leave the AWS/SES values empty locally: decision emails then wait in the outbox.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM="HackXperience by CIReN <hackathons@notify.ciren.network>"
SES_REPLY_TO=admin.cirenet@gmail.com
# The SNS topic that delivers SES bounces and complaints to /api/internal/ses-events.
SNS_TOPIC_ARN=
# Server only. Read-only token from a CIReN GitHub account, for commit hashes at the deadline.
# Optional locally: without it GitHub allows 60 requests an hour.
GITHUB_TOKEN=
# Server only. Needed only if the Expo project enables enhanced push security.
EXPO_ACCESS_TOKEN=

# --- Mobile (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the web app that serves /api/v1 (e.g. https://hack.ciren.network)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
