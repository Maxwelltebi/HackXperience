# Copy to apps/web/.env.local (web) and apps/mobile/.env (mobile). Never commit real values.

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Server only. Production: Supabase pooler, transaction mode (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Mobile (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the web app that serves /api/v1 (e.g. https://hack.ciren.network)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
